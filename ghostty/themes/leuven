# Ghostty theme based on Emacs leuven.
# Palette source: leuven-theme.el by Fabrice Niessen, bundled with GNU Emacs
# 30.2 (etc/themes/, GPL-3.0-or-later).
#
# leuven's own `ansi-color-*' faces are X11 names (yellow3, deep sky blue,
# lime green, ...) that sit at 1.5-2.5:1 against its white background, so the
# ANSI slots here come from the theme's *code* faces instead -- the same hues
# leuven itself uses for text, all at >= 4:1 on white:
#
#   0/8   default fg / `shadow'     8 is the conventional grey for dim text
#   1     font-lock-constant        2   string          4   keyword (#0000FF)
#   5     font-lock-variable-name   6   teal (diff/org)  3  leuven's lone orange
#   9     `error'-weight red        10  success green   12  font-lock-builtin
#   13    font-lock-type            14  font-lock-function-name
#   11    darkened gold: leuven has no legible yellow on white, so this one is
#         derived rather than lifted
#   7/15  light greys, near-background, as light themes require

palette = 0=#333333
palette = 1=#d0372d
palette = 2=#008000
palette = 3=#bb6600
palette = 4=#0000ff
palette = 5=#ba36a5
palette = 6=#007777
palette = 7=#e5e5e5
palette = 8=#7f7f7f
palette = 9=#cc0000
palette = 10=#158a15
palette = 11=#9a6f00
palette = 12=#006fe0
palette = 13=#6434a3
palette = 14=#006699
palette = 15=#f2f2f2

background = #ffffff
foreground = #333333

# leuven's `cursor' face (sky blue), with dark text so the glyph under it reads.
cursor-color = #21bdff
cursor-text = #000000

# leuven's `region'.
selection-background = #8ed3ff
selection-foreground = #333333
